{
	"name": "lwc-plugin-interactive-price-lines",
	"version": "1.7.0",
	"description": "Draggable, annotated price lines (orders, alerts, holdings) with host-owned editing and actions, for Lightweight Charts™.",
	"author": "Oliver Seidel",
	"license": "Apache-2.0",
	"type": "module",
	"types": "./dist/interactive-price-lines.d.ts",
	"exports": {
		".": {
			"types": "./dist/interactive-price-lines.d.ts",
			"default": "./dist/interactive-price-lines.js"
		},
		"./standalone": {
			"types": "./dist/interactive-price-lines.d.ts",
			"default": "./dist/interactive-price-lines.standalone.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"NOTICE"
	],
	"keywords": [
		"lightweight-charts",
		"lightweight-charts-plugin",
		"lwc-plugin",
		"price-line",
		"order-line",
		"alert",
		"trading",
		"chart"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "vite --config src/vite.config.js",
		"build": "tsc && node compile.mjs",
		"typecheck": "tsc --noEmit",
		"check-package": "publint --strict && attw --pack . --ignore-rules no-resolution cjs-resolves-to-esm"
	},
	"peerDependencies": {
		"lightweight-charts": "^5.0.0"
	},
	"dependencies": {
		"fancy-canvas": "~2.1.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "~0.18.5",
		"@tradingview/lwc-toolkit": "~1.0.0",
		"dts-bundle-generator": "~9.5.1",
		"lightweight-charts": "^5.0.0",
		"publint": "~0.3.14",
		"typescript": "~5.9.3",
		"vite": "~8.2.2"
	},
	"lwcPlugin": {
		"title": "Interactive price lines",
		"category": "series-primitive",
		"lifecycle": "experimental",
		"origin": "community",
		"author": "Oliver Seidel",
		"demo": "src/example/index.html",
		"tags": [
			"price line",
			"interactive",
			"orders",
			"alerts"
		]
	}
}
